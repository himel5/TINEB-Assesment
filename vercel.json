{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "includeFiles": [
        "index.html",
        "css/style.css",
        "js/app.js",
        "data/representatives.csv"
      ]
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js" },
    { "source": "/api-docs", "destination": "/api/index.js" },
    { "source": "/openapi.json", "destination": "/api/index.js" }
  ]
}
